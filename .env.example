# BonBonn Game Tracker Environment Configuration
# Production file: /home/github/bonbonn-game-tracker/.env (mode 0600)

# Server
PORT=12000
ADMIN_HOST=admin.faceitlobby.com

# Admin HTTP Basic Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_generated_password

# Faceit API (allowed empty until set by user)
FACEIT_API_KEY=
apiKey=

# PostgreSQL (shared postgres-prod container on the postgres_prod network)
# Use URL-safe credentials, e.g. random hexadecimal passwords.
DATABASE_URL=postgres://bonbonn:change_this_to_a_strong_password@postgres-prod:5432/bonbonn?sslmode=disable

# Public Route Reference & Quirks:
# GET  /elo?username=<faceit_username> (CSGO ELO with optional CS2 ELO)
# GET  /checkelo?username=<faceit_username> (same as /elo)
# GET  /elobyid?id=<faceit_uuid> (Faceit player UUID)
# GET  /elobysteamid?id=<steam64_id> (17-digit Steam64 ID)
# GET  /matchhistory?username=<faceit_username>&limit=<4-100> (CS2 match history)
# GET  /getmatch?key=<streamer_uuid> ("This User is currently not in a matchroom" or details)
# GET  /redirect?key=<streamer_uuid> (302 redirect to matchroom; link access, not human click)
# POST /match (Faceit webhook, header Authorization: <streamer_uuid>; match_status_configuring calculates map, match_object_created returns 'Invalid Request oder match is already closed', other events close match)
